<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторна робота 2 - Потоки" Height="700" Width="780"
        MinWidth="640" MinHeight="600" Background="#F3F4F6">

    <Window.Resources>
        <!-- Біла картка із заокругленими кутами -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Background="#1E3A8A" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Рекурентна функція у потоках" Foreground="White"
                           FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Метод простої ітерації: кожне рівняння рахується в окремому потоці"
                           Foreground="#BFDBFE" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Керування -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,14,16,6">
            <TextBlock Text="Похибка:" VerticalAlignment="Center" FontSize="14"/>
            <TextBox x:Name="EpsilonBox" Text="0,01" Width="80" Margin="8,0,20,0"
                     FontSize="14" Padding="4" VerticalContentAlignment="Center"/>
            <Button x:Name="StartButton" Content="▶  Запустити потоки" Click="StartButton_Click"
                    Background="#2563EB" Foreground="White" BorderThickness="0"
                    Padding="18,7" FontSize="14"/>
        </StackPanel>

        <!-- Дві картки з результатами -->
        <Grid Grid.Row="2" Margin="16,6,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" BorderBrush="#2563EB" BorderThickness="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Потік 1:  2x - cos(x) = 0" Foreground="#2563EB" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Root1Text" Text="X = ?" FontSize="26" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBlock x:Name="Info1Text" Text="очікування запуску" Foreground="#6B7280"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" BorderBrush="#F97316" BorderThickness="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Потік 2:  x + ln(x) = 0" Foreground="#F97316" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Root2Text" Text="X = ?" FontSize="26" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBlock x:Name="Info2Text" Text="очікування запуску" Foreground="#6B7280"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Графік збіжності -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="16,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Збіжність ітерацій" FontWeight="SemiBold" Margin="0,0,20,0"/>
                    <TextBlock Text="● 2x - cos(x) = 0" Foreground="#2563EB" Margin="0,0,14,0"/>
                    <TextBlock Text="● x + ln(x) = 0" Foreground="#F97316"/>
                </StackPanel>
                <Canvas x:Name="ChartCanvas" Grid.Row="1" Margin="0,8,0,0"
                        ClipToBounds="True" SizeChanged="ChartCanvas_SizeChanged"/>
            </Grid>
        </Border>

        <!-- Журнал -->
        <TextBox x:Name="OutputBox" Grid.Row="4" Margin="16,6,16,16" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                 Padding="8" BorderBrush="#E5E7EB"/>
    </Grid>
</Window>